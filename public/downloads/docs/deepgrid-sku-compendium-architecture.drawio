        </mxCell>

        <mxCell id="d100_failsafe" value="HARDWARE FAILSAFE ISLAND (THE WEDGE)&#xa;• Link Monitor + Safe-State FSM Direct to ESC&#xa;• Completely Isolated Power &amp; Clock from Linux Stack&#xa;• Bypasses FC, VIO, and AI upon OS Crash or EW Jamming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontStyle=1;fontSize=10;" vertex="1" parent="zone_d100">
