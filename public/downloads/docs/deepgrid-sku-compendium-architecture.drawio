        <mxCell id="sip_flipchip" value="Wave 2 Flip-Chip AI Compute Die&#xa;(28 nm Multi-TOPS Linux Processor)&#xa;[Joins after ₹50 Cr Round · High-Bandwidth Micro-Bumps]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontStyle=1;fontSize=10;" vertex="1" parent="zone_sip">
          <mxGeometry x="25" y="195" width="370" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sip_advantage" value="ARCHITECTURAL INVERSION: DELIBERATELY NOT UCIe&#xa;• Avoids $10M+ silicon interposers and fragile TSV processing&#xa;• 120V BCD power dies sit 2 mm from 1.8V digital logic&#xa;• AEC-Q100 Grade 0 and MIL-STD-883 thermal relief via design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontSize=9;" vertex="1" parent="zone_sip">
          <mxGeometry x="25" y="275" width="370" height="120" as="geometry"/>
        </mxCell>

        <!-- ZONE 3: TRACK B — D100 TACTICAL DRONE SOC (SHEET 11) -->
        <mxCell id="zone_d100" value="ZONE 3: SHEET 11 — D100 TACTICAL DRONE SOC (PX4 + 30Hz VIO + FAILSAFE)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#FDF4FF;strokeColor=#A21CAF;strokeWidth=2;spacingTop=10;" vertex="1" parent="1">
