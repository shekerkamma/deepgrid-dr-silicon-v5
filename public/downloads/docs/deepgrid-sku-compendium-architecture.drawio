        <mxCell id="d100_market" value="SOVEREIGN PROCUREMENT MOAT (DAP-2020 MAKE-II)&#xa;• Indian Drone Market: $1.2B–$1.3B growing to $3.2B&#xa;• ₹1.01 Cr Pre-ASIC validation contract signed with Indian Army MCEME&#xa;• Zero domestic FC+VIO competitor exists in the defense supply chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#BE185D;fontStyle=1;fontSize=9;" vertex="1" parent="zone_d100">
          <mxGeometry x="25" y="260" width="370" height="150" as="geometry"/>
        </mxCell>

