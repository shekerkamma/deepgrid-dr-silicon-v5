        <mxCell id="zone_sdv" value="ZONE 4: SHEET 12 — DEEPGRID SDV PLATFORM MATRIX (64-BIT AXI4 + REALM QoS)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#4338CA;strokeWidth=2;spacingTop=10;" vertex="1" parent="1">
