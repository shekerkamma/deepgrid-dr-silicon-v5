          <mxGeometry x="20" y="185" width="420" height="60" as="geometry"/>
        </mxCell>

        <!-- SKU 4 to 6 -->
        <mxCell id="sku_4" value="SKU-4: Dual-Core Lockstep Safety MCU&#xa;(130nm CMOS · Dual DGridRiscV with 2-Cycle Skew @ 200MHz)&#xa;[Bus+Retire Comparator Asserting FAULTn in &lt;2 Cycles · ISO 26262 ASIL-D]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=10;" vertex="1" parent="zone_skus">
          <mxGeometry x="20" y="255" width="420" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sku_5" value="SKU-5: Robust Interface Transceiver&#xa;(130nm Thick-Oxide 5V LDMOS · ±15 kV HBM ESD Protection)&#xa;[RS-485 + ISO 11898-2 CAN-FD 5 Mbps · 30 mV Receiver Hysteresis]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;fontSize=10;" vertex="1" parent="zone_skus">
