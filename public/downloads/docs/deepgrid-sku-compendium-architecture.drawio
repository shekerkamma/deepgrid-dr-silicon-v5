        <mxCell id="sdv_accel" value="Vector &amp; Integer Multi-Core Accelerators&#xa;Low-Latency TCDM Bus · Interleaved Bank Addressing Switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontStyle=1;fontSize=10;" vertex="1" parent="zone_sdv">
          <mxGeometry x="20" y="330" width="370" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="sdv_satellites" value="SATELLITE CHIP INTERFACE MESH&#xa;• SKU-9 Zonal Gateway (Gigabit Ethernet TSN + 16x e-fuses)&#xa;• SKU-7 77 GHz SiGe 4D Imaging Radar (Perception Edge)&#xa;• SKU-1 BLDC Motor Inverter (120V Powertrain Drive)&#xa;• SKU-3 Avionics PMIC &amp; SKU-6 Precision Voltage Supervisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;fontStyle=1;fontSize=10;" vertex="1" parent="zone_sdv">
          <mxGeometry x="20" y="405" width="370" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="sdv_scope_honesty" value="SCOPE HONESTY (FROM SHEET 10 &amp; 12)&#xa;• 130 nm at 200 MHz owns the ZONAL and GATEWAY layer&#xa;• Central SDV compute (multi-GHz, GPU, LPDDR5) is sub-10 nm&#xa;• DeepGrid explicitly does NOT claim central infotainment HPC on 130nm&#xa;• Every sub-10nm central chip requires 5–10 mature satellite chips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontSize=9;" vertex="1" parent="zone_sdv">
          <mxGeometry x="20" y="555" width="370" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="sdv_procurement" value="DEFENSE &amp; STRATEGIC SOVEREIGNTY MOAT&#xa;• DAP-2020 Buy (Indian-IDDM): Top statutory priority for Indian silicon&#xa;• Make-II Scheme: Industry-funded prototype with guaranteed purchase&#xa;• PIL-5: Legal import bans on competing foreign sensor &amp; motor ICs&#xa;• SCL Mohali: 100% non-embargoable domestic fabrication backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontSize=9;" vertex="1" parent="zone_sdv">
          <mxGeometry x="20" y="725" width="370" height="135" as="geometry"/>
        </mxCell>

