        <!-- Title Block -->
        <mxCell id="title_banner" value="DEEPGRID DG32 — HARDWARE DSHOT RX &amp; BIDIRECTIONAL TELEMETRY ARCHITECTURE (dgrid_dshot_rx)&#xa;In-Place Slot 0xC Extension · GCR 4b→5b Transition Encoding · Pad-Ring Direction Control · Lockstep Invariant (W1C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b1a;strokeColor=#d4a36e;strokeWidth=2;fontColor=#d4a36e;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1840" height="70" as="geometry" />
        </mxCell>

        <!-- ZONE 1: BUS INTERFACE & LOCKSTEP SAFETY DOMAIN -->
        <mxCell id="zone_bus_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#121615;strokeColor=#4fc3f7;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="400" height="880" as="geometry" />
        </mxCell>
        <mxCell id="zone_bus_label" value="AXI-LITE &amp; DUAL-CORE LOCKSTEP COMPARATOR DOMAIN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4fc3f7;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="55" y="140" width="370" height="30" as="geometry" />
        </mxCell>

        <mxCell id="node_main_core" value="MAIN RV32IM CORE&#xa;(50 MHz Clock · Control Loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2421;strokeColor=#81c784;strokeWidth=2;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="190" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="node_checker_core" value="CHECKER RV32IM CORE&#xa;(2-Cycle Skewed Mirror)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2421;strokeColor=#81c784;strokeWidth=2;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="190" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="node_lockstep_check" value="dgrid_lockstep_check&#xa;Compares All Committed Stores &amp; Bus Cycles&#xa;FAULTn Triggers in 2 Cycles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1818;strokeColor=#e57373;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="65" y="290" width="350" height="60" as="geometry" />
        </mxCell>

