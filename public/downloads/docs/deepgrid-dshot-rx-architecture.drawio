  <diagram id="dgrid_dshot_rx_arch" name="DG32 DShot RX & Bidirectional Telemetry Architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#0d1110">
      <root>
