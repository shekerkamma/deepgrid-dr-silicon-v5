          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_core_to_comp2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#81c784;strokeWidth=2;" edge="1" source="node_checker_core" target="node_lockstep_check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="node_axi_master" value="AXI-Lite 32-bit Bus Matrix&#xa;Synchronous Peripheral Access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16232b;strokeColor=#4fc3f7;strokeWidth=2;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="380" width="350" height="50" as="geometry" />
        </mxCell>

        <mxCell id="edge_main_to_axi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4fc3f7;strokeWidth=2;" edge="1" source="node_main_core" target="node_axi_master" parent="1">
          <mxGeometry relative="1" as="geometry">
