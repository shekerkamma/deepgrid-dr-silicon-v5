        <mxCell id="node_pma_rule" value="CPU PMA WHITELIST: fault = !(addr[31] | addr[31:28]==0x1) · SRAM at 0x9, XIP at 0x1, Peripherals at 0xC/0xD/0xE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24231b;strokeColor=#ffd54f;strokeWidth=1;fontColor=#ffe082;fontSize=10;align=center;" vertex="1" parent="1">
