              <mxPoint x="315" y="420" />
              <mxPoint x="315" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Motor & Sensor Peripherals Grid -->
        <mxCell id="node_pwm" value="3-Phase PWM (0xD8)&#xa;Center-aligned complementary&#xa;Dead-time (5.1 µs) · HW Brake &lt;=2cyc&#xa;sample_trig at ripple null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c261e;strokeColor=#81c784;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_cordic" value="CORDIC Engine (0xDE)&#xa;Q1.31 rotation &amp; vectoring&#xa;sin/cos/atan2/mag in 53-58 cyc&#xa;Fixed FOC latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c261e;strokeColor=#81c784;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="510" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_adc" value="SAR ADC (0xDB)&#xa;8-bit differential OpenFASOC&#xa;177 cyc on-die conversion&#xa;Replaces 1.9 µs external SPI read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c261e;strokeColor=#81c784;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_encoder" value="Encoder + Hall (0xDA)&#xa;Quad A/B/Z + 3 Hall lines&#xa;32-bit free-running timestamp&#xa;Low-speed velocity estimation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c261e;strokeColor=#81c784;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="510" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_dshot" value="DShot ESC Engine (0xC0)&#xa;4 channels pin-muxed on PWM&#xa;Hardware RX &amp; GCR Telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c261e;strokeColor=#81c784;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="510" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Comms & System Slaves -->
        <mxCell id="node_uart" value="UART0 / UART1 (0xD0/D1)&#xa;Console &amp; Telemetry (8N1)&#xa;115,200 baud @ 50 MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2420;strokeColor=#a5d6a7;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_spi_i2c" value="SPI (0xD2) &amp; I2C (0xD9)&#xa;25 MHz SPI Master&#xa;100/400 kHz Open-Drain I2C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2420;strokeColor=#a5d6a7;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="610" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_gpio_tmr" value="GPIO (0xD3) &amp; Timers (0xD4/D5)&#xa;16 pins atomic SET/CLR&#xa;RTOS tick + control one-shot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2420;strokeColor=#a5d6a7;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="610" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_supv_irq" value="Supervisor (0xD7) &amp; IRQ (0xDF)&#xa;Windowed WDT (WDTMIN/MAX)&#xa;16-source masked IRQ controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2420;strokeColor=#a5d6a7;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="610" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_qspi_xip" value="QSPI-XIP Window (0x10)&#xa;External NOR Flash read window&#xa;Boot ROM copies flash to SRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2420;strokeColor=#a5d6a7;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="610" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- FOC Control Loop Performance Panel -->
        <mxCell id="node_foc_budget" value="FOC CURRENT LOOP BUDGET (§5) · ~100 kHz CLOSED-LOOP BANDWIDTH&#xa;• Fixed Hardware Cost: ~300 cycles (~6 µs) @ 50 MHz (ADC sample 177 cyc + 2× CORDIC 106 cyc + PWM write)&#xa;• CPU PI Regulators: ~8 cyc/instruction (Fetch-bound core; int8 MAC takes 54 cyc vs 6 with I-cache)&#xa;• 10 kHz Loop Rate: 5000 cyc period → ~4700 cycles (&gt;90%) FREE CPU HEADROOM for full state observers&#xa;• Post-Route fmax: Core 55-62 MHz (50 MHz target); peripherals &gt;167 MHz (never the timing wall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a261c;strokeColor=#4caf50;strokeWidth=1.5;fontColor=#c8e6c9;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1080" height="90" as="geometry" />
        </mxCell>

        <!-- AVIP CSA Panel -->
        <mxCell id="node_csa_panel" value="CURRENT SIGNATURE ANALYSIS (CSA) FRONT END (§11.3) · ZERO ACCELEROMETER REQUIREMENT&#xa;• Sensor: On-die SAR ADC (0xDB) triggered at PWM current-ripple null → no external vibration probes!&#xa;• Physical Principle: Stator current modulated by bearing defect airgap eccentricity: f_fault = f_e ± k*f_defect&#xa;• Dual Output: Classical BPFO/BPFI/BSF sideband energy (9 KB, runs on DG32-LITE) + (35,20,20,2) INT8 tensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24231b;strokeColor=#ffb74d;strokeWidth=1.5;fontColor=#ffe082;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="1080" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_area_breakdown" value="PHYSICAL AREA BREAKDOWN (3400 × 4500 µm Die = 15.30 mm² total):&#xa;• 18 Hard SRAM Macros = 5.12 mm² (86% of 5.93 mm² placed cell+macro area!)&#xa;• Standard-Cell Logic Subtotal = 0.751 mm² (both RISC-V cores = 0.33 mm², Attention logic = 0.07 mm²)&#xa;• SRAM Sizing (dropping 2 macros = 28 KB) saves 0.57 mm² as the primary routability lever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#191d24;strokeColor=#ba68c8;strokeWidth=1.5;fontColor=#e1bee7;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="1080" height="80" as="geometry" />
        </mxCell>

        <!-- ZONE 2: CLOCK-DOMAIN CROSSING (CDC) BRIDGES -->
        <mxCell id="zone_cdc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#181924;strokeColor=#ba68c8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="130" width="180" height="890" as="geometry" />
        </mxCell>
        <mxCell id="zone_cdc_label" value="CDC BRIDGES" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#ba68c8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="140" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="node_cdc_lite" value="dgrid_axi_cdc_lite&#xa;AXI-Lite 0xE000_0000&#xa;Shape Programming&#xa;4-phase req/ack&#xa;2-FF synchronizers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231f2b;strokeColor=#ba68c8;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1205" y="240" width="150" height="100" as="geometry" />
        </mxCell>

        <mxCell id="node_cdc_burst" value="dgrid_axi_cdc_burst&#xa;Read/Write Burst&#xa;Batched crossings&#xa;K/V buffer fill&#xa;O writeback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231f2b;strokeColor=#ba68c8;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1205" y="440" width="150" height="100" as="geometry" />
        </mxCell>

        <mxCell id="node_cdc_rule" value="Timing Invariant:&#xa;Core 50 MHz closure&#xa;is undisturbed!&#xa;Engine cannot stall&#xa;the CPU domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d1e2b;strokeColor=#f06292;fontColor=#f8bbd0;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1205" y="650" width="150" height="110" as="geometry" />
        </mxCell>

        <mxCell id="edge_axi_to_cdclite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#29b6f6;strokeWidth=2;" edge="1" source="node_axi_fabric" target="node_cdc_lite" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="460" />
              <mxPoint x="1160" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ZONE 3: 114 MHz INT8 ATTENTION ENGINE DOMAIN -->
        <mxCell id="zone_attn_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101618;strokeColor=#00e5ff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1400" y="130" width="480" height="890" as="geometry" />
        </mxCell>
        <mxCell id="zone_attn_label" value="114 MHz INT8 ATTENTION ENGINE DOMAIN (clk_fast_i · 4.18)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#00e5ff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="440" height="30" as="geometry" />
        </mxCell>

        <mxCell id="node_attn_ctrl" value="AXI-Lite Programming Port (0xE000_0000)&#xa;Shapes: M (Query Rows), N (Keys &lt;=400), K (KD &lt;=32), DV &lt;=64&#xa;A_BASE (Q), B_BASE (K), C_BASE (V), D_BASE (O), E_BASE (EXP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152427;strokeColor=#00e5ff;fontColor=#ffffff;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1420" y="180" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="node_attn_buffers" value="ON-CHIP K &amp; V RESIDENCY BUFFERS (sky130 SRAM Macros)&#xa;• K Buffer (NK × KD): Loaded once per kick via DMA, re-read per query row&#xa;• V Buffer (NK × DV): Re-read per row (streaming V would be 400× bus traffic!)&#xa;• Per-head traffic is ~1% bus occupancy; prevents memory contention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18282b;strokeColor=#00e5ff;fontColor=#e0f7fa;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1420" y="270" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node_mac_array" value="LANES × (s16 × s9) MAC Array (LANES = 16, LUTs)&#xa;Shared between QK^T (reduced over d) and E.V (per-lane)&#xa;Zero DSP slices used (USE_DSP=no)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152427;strokeColor=#00e5ff;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="370" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_softmax_pipeline" value="SOFTMAX PIPELINE &amp; 40-BIT ACCUMULATOR SEAT&#xa;• Running Row Maximum: Subtracted from dot products&#xa;• 256-Entry u15 EXP Table: Weights NEVER quantized to INT4 (1/400 != 0!)&#xa;• 40-Bit Signed Numerator Seat: Exact to NK=131072 (int32 breaks @ NK=512)&#xa;• 48-Step Restoring Divider: Evaluates per-row reciprocal 1/Z&#xa;• Saturation: Final projection E.V saturated to signed int8 (O output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182b2e;strokeColor=#00e5ff;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1420" y="450" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="node_avip_perf" value="AVIP MULTIMODAL INFERENCE APPLICATION (§11)&#xa;• Model: Time conv/GRU + FFT conv/GRU + 2 self-attn + 1 cross-attn&#xa;• CWRU Model: 47,076 params · 46.7 ms latency on clk_fast_i (94-95% acc)&#xa;• Full AVIP: 478,277 params (10× params, only 1.2× compute!) · 54.5 ms&#xa;• Zero CPU Steal: Runs on clk_fast_i; motor FOC core continues untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c2420;strokeColor=#66bb6a;strokeWidth=1.5;fontColor=#c8e6c9;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1420" y="580" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="edge_cdclite_to_attn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00e5ff;strokeWidth=2;" edge="1" source="node_cdc_lite" target="node_attn_ctrl" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_attn_to_burst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ba68c8;strokeWidth=2;" edge="1" source="node_attn_buffers" target="node_cdc_burst" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="310" />
              <mxPoint x="1380" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>

