        <mxCell id="node_sram_box" value="32 KB AXI SRAM (0x9000_0000)&#xa;16× sky130 1rw1r macros (512×32 each)&#xa;Port 0: LSU read/write · Port 1: Idle Read Port for DMA/Attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#19222c;strokeColor=#4fc3f7;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="760" y="180" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="node_dma" value="DMA Block Mover (0xDC00_0000)&#xa;Single-beat AXI master (~7.1 cyc/word)&#xa;Contention-free SRAM idle port feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#19222c;strokeColor=#4fc3f7;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="310" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- AXI Bus Fabric (21 Decoded Slaves) -->
        <mxCell id="node_axi_fabric" value="21-SLAVE DECODED AXI FABRIC (addr[31:28] + addr[27:24] Sub-Decode · arsel_q Handshake Latch · SLVERR Error Slave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152028;strokeColor=#29b6f6;strokeWidth=2;fontColor=#81d4fa;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1080" height="40" as="geometry" />
        </mxCell>

        <mxCell id="edge_lsu_to_axi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2.5;" edge="1" source="node_main_core" target="node_axi_fabric" parent="1">
