        <mxCell id="title_banner" value="DEEPGRID DG32-2DOM — DUAL-DOMAIN SYSTEM ARCHITECTURE &amp; ATTENTION VARIANT (CI2612)&#xa;sky130A 130 nm · 3400 × 4500 µm Die · 50 MHz Core Domain / 114 MHz Fast Accelerator Domain · 40-Bit Attention Numerator · Zero-Accelerometer CSA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161b1a;strokeColor=#00e5ff;strokeWidth=2;fontColor=#00e5ff;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1">
