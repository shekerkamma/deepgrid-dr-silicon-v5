        <!-- Title Block -->
        <mxCell id="title" value="&lt;b&gt;DEEPGRID SEMI — MATURE-NODE SILICON ARCHITECTURE &amp; OPERATIONAL PLAYBOOK&lt;/b&gt;&lt;br&gt;&lt;font color='#94A3B8'&gt;71-Page Master Whitepaper v3 · $9B Import Funnel · 10x Cost Cut · 198-Day Loop · 3-Factory Sovereignty · Stop Rules S1–S4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="60" as="geometry" />
        </mxCell>

        <!-- SECTION 1: THE $9B IMPORT FUNNEL -->
        <mxCell id="grp_funnel" value="1. THE $9B IMPORT FUNNEL (UN COMTRADE HS 8542)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;fontSize=13;fontStyle=1;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="460" height="340" as="geometry" />
        </mxCell>
        <mxCell id="fnl_total" value="&lt;b&gt;$23.4 Billion&lt;/b&gt;&lt;br&gt;Total Indian IC Imports&lt;br&gt;&lt;font color='#94A3B8'&gt;~70% from China &amp; Taiwan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="grp_funnel">
          <mxGeometry x="30" y="45" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fnl_mature" value="&lt;b&gt;$9.0 Billion (Mature Nodes ≥ 130 nm)&lt;/b&gt;&lt;br&gt;Power, PMIC, small MCUs, line transceivers, metrology AFE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#38BDF8;fontSize=11;" vertex="1" parent="grp_funnel">
          <mxGeometry x="50" y="105" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fnl_9classes" value="&lt;b&gt;$0.46 Billion (~$460M)&lt;/b&gt;&lt;br&gt;Addressable Sockets: 9 DeepGrid Mature-Node Chip Classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;fontColor=#10B981;fontSize=11;" vertex="1" parent="grp_funnel">
          <mxGeometry x="70" y="165" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fnl_fy31" value="&lt;b&gt;₹1,000 Crore (~$105M) by FY31&lt;/b&gt;&lt;br&gt;Meters ₹480Cr · Motors ₹220Cr · Defence ₹200Cr · Drones ₹100Cr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;fontColor=#F59E0B;fontSize=11;" vertex="1" parent="grp_funnel">
          <mxGeometry x="90" y="225" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fnl_live" value="&lt;b&gt;₹2.88 Crore Live Contracted Orders Today&lt;/b&gt;&lt;br&gt;MCEME (Army) ₹1.01Cr · Infinis ₹1.25Cr · Axitech ₹0.62Cr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#34D399;fontColor=#ECFDF5;fontSize=11;fontStyle=1;" vertex="1" parent="grp_funnel">
          <mxGeometry x="110" y="280" width="240" height="45" as="geometry" />
