        <mxCell id="title" value="DG32-2DOM system architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="die" value="DG32-2DOM  ·  3.4 × 4.5 mm die  ·  two clock domains  ·  same QFN-64 pinout as DG32-LITE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#0A1628;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0A1628;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1420" height="760" as="geometry" />
        </mxCell>

        <!-- Control domain -->
        <mxCell id="zCtl" value="50 MHz control domain  ·  identical to DG32-LITE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8FC;strokeColor=#00B4D8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="560" height="700" as="geometry" />
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;Lockstep CPU pair&lt;/b&gt;&lt;br&gt;MAIN + CHECKER, RV32IM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00B4D8;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="160" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="safe" value="&lt;b&gt;Fault latch + supervision&lt;/b&gt;&lt;br&gt;FAULT_N · watchdog · supplies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mem" value="&lt;b&gt;Boot ROM + SRAM&lt;/b&gt;&lt;br&gt;64 KB · 32 KB dual-port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="260" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dma" value="&lt;b&gt;DMA&lt;/b&gt;&lt;br&gt;can feed the engine from the idle SRAM read port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="irq" value="&lt;b&gt;Interrupt controller&lt;/b&gt;&lt;br&gt;16 sources, engine done included" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="qspi" value="&lt;b&gt;QSPI controller&lt;/b&gt;&lt;br&gt;boot from external flash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;On-chip bus&lt;/b&gt;  ·  bus error, never a hang" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0A1628;strokeColor=#0A1628;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="90" y="465" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mtr" value="&lt;b&gt;Motor drive + sensing&lt;/b&gt;&lt;br&gt;PWM · DShot · encoder · ADC · CORDIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0A9396;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
