        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Weight&lt;/b&gt;&lt;br&gt;row max → softmax EXP table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0A9396;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
