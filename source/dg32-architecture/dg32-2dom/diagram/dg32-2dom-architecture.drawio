        <mxCell id="s4" value="&lt;b&gt;4 · Combine&lt;/b&gt;&lt;br&gt;weighted sum ÷ one reciprocal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0A9396;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1">
