        </mxCell>
        <mxCell id="ctlnote" value="Control loop unchanged: ~300 hardware cycles per loop, ~100 kHz simulated ceiling. The engine cannot extend the core's worst-case execution time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
