  <diagram name="DG32-2DOM architecture">
    <mxGraphModel dx="1500" dy="920" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="920" background="#FFFFFF">
      <root>
        <mxCell id="0" />
